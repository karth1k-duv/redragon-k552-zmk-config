#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* Row 1 */
                &kp ESC  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12  &kp PSCRN &kp DEL  &kp HOME &kp END

                /* Row 2 */
                &kp GRAVE &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS &kp EQUAL &kp BSPC &kp INS &kp PG_UP &kp PG_DN

                /* Row 3 */
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH &kp UP &kp NONE &kp NONE

                /* Row 4 */
                &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp ENTER &kp LEFT &kp DOWN &kp RIGHT &kp NONE

                /* Row 5 */
                &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHIFT &kp LCTRL &kp LALT &kp SPACE &kp RALT &kp RCTRL

                /* Row 6 */
                &kp LGUI &kp ESC &kp TAB &kp ENTER &kp BACKSPACE &kp SPACE &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp HOME &kp END &kp PG_UP &kp PG_DN &kp INSERT &kp DELETE &kp RGUI
            >;
        };
    };
};
