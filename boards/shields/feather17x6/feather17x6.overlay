#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

#include "feather17x6-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    /*
     * ============================================================
     * KEYBOARD MATRIX
     * ============================================================
     *
     * 6 rows  x  17 columns
     *
     * Rows:
     *   Q0 -> Row 1
     *   Q1 -> Row 2
     *   Q2 -> Row 3
     *   Q3 -> Row 4
     *   Q4 -> Row 5
     *   Q5 -> Row 6
     *
     * Columns:
     *   C1  -> P0.25
     *   C2  -> P0.24
     *   C3  -> P1.08
     *   C4  -> P0.07
     *   C5  -> P0.26
     *   C6  -> P0.06
     *   C7  -> P0.08
     *   C8  -> P1.09
     *   C9  -> P0.04
     *   C10 -> P0.05
     *   C11 -> P0.30
     *   C12 -> P0.28
     *   C13 -> P0.02
     *   C14 -> P0.03
     *   C15 -> P0.12  (SDA-labeled pin)
     *   C16 -> P0.11  (SCL-labeled pin)
     *   C17 -> P0.15  (MISO-labeled pin)
     *
     * UART D0/D1 and I2C SDA/SCL are therefore ordinary GPIOs.
     * We are NOT enabling UART or I2C peripherals on these pins.
     */

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "row2col";

        /*
         * Rows are driven by the 74HC595.
         */
        row-gpios =
            <&shifter 0 GPIO_ACTIVE_HIGH>,
            <&shifter 1 GPIO_ACTIVE_HIGH>,
            <&shifter 2 GPIO_ACTIVE_HIGH>,
            <&shifter 3 GPIO_ACTIVE_HIGH>,
            <&shifter 4 GPIO_ACTIVE_HIGH>,
            <&shifter 5 GPIO_ACTIVE_HIGH>;

        /*
         * Columns are Feather GPIO inputs.
         *
         * Pull-downs keep the inputs defined while a row
         * is not being driven.
         */
        col-gpios =
            <&gpio0 25 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 30 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    /*
     * ============================================================
     * 6 x 17 MATRIX TRANSFORM
     * ============================================================
     *
     * This is a basic row-major mapping.
     *
     * 102 possible matrix positions exist.
     * The basic layout below uses all 102 positions.
     */
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        rows = <6>;
        columns = <17>;

        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16)
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16)
            RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)  RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(4,16)
            RC(5,0)  RC(5,1)  RC(5,2)  RC(5,3)  RC(5,4)  RC(5,5)  RC(5,6)  RC(5,7)  RC(5,8)  RC(5,9)  RC(5,10) RC(5,11) RC(5,12) RC(5,13) RC(5,14) RC(5,15) RC(5,16)
        >;
    };
};


/*
 * ================================================================
 * 74HC595
 * ================================================================
 *
 * Feather:
 *
 *   MOSI P0.13 -> 595 pin 14 SER
 *   SCK  P0.14 -> 595 pin 11 SRCLK
 *   D10  P0.27 -> 595 pin 12 RCLK
 *
 * 595:
 *
 *   pin 16 VCC -> 3.3V
 *   pin 8  GND -> GND
 *   pin 10 SRCLR -> 3.3V
 *   pin 13 OE -> GND
 */

&spi1 {
    status = "okay";

    /*
     * Hardware latch/CS.
     *
     * P0.27 / Feather D10
     */
    cs-gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;

    shifter: shifter@0 {
        compatible = "zmk,gpio-595";

        status = "okay";

        reg = <0>;

        gpio-controller;
        #gpio-cells = <2>;

        ngpios = <8>;

        /*
         * 1 MHz is comfortably fast for this matrix.
         */
        spi-max-frequency = <1000000>;
    };
};
